# Copier vers .env.local (dev) — jamais commiter les valeurs réelles.

# PostgreSQL. En dev local, Docker sur le port 5433 (voir README).
DATABASE_URL="postgresql://chronos:chronos123@127.0.0.1:5433/chronos"

# Port du serveur (API + client servis sur le même port).
PORT=5000

# API officielle Brawl Stars (https://developer.brawlstars.com).
# Le token est verrouillé par IP : autoriser l'IP du poste/VPS.
BRAWLSTARS_API_TOKEN=

# Secret de session (générer une valeur aléatoire).
SESSION_SECRET=
